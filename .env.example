# 로컬 실행에 필요한 환경 변수 예시 파일입니다. / Template for local environment variables.
# ─────────────────────────────────────────────────────────────
# centagging 환경 변수 템플릿
#
# 사용법:
#   cp .env.example .env
#   그 뒤 .env 파일에 실제 키 값을 채워 넣으세요.
#
#   .env 는 .gitignore 로 제외됩니다. 절대 커밋하지 마세요.
# ─────────────────────────────────────────────────────────────


# 애플리케이션 설정 / Application settings
APP_ENV=local
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=8501

# MVP fixed login account
# Set real values only in .env. Never commit the actual password.
MVP_LOGIN_ID=your-mvp-login-id
MVP_LOGIN_PASSWORD=your-mvp-login-password

# AI 서비스 설정 / AI service settings
# Configure one local API key. Leave unused values empty.
# Local Vertex AI Express Mode. FastAPI prefers this value when configured.
VERTEX_API_KEY=

# Production Vertex AI uses VM service-account ADC with these routing values.
GCP_PROJECT_ID=
VERTEX_AI_LOCATION=global

# Backward-compatible Gemini Developer API fallback for local utilities.
GEMINI_API_KEY=
GEMINI_VLM_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# SKU 검색 결과 재정렬(Top-30 후보 풀 -> LLM 재정렬)에 사용하는 모델입니다.
GEMINI_RERANK_MODEL=gemini-2.5-flash-lite

# Fused embedding image preprocessing
IMAGE_PREPROCESS_ENABLED=true
EMBEDDING_PIPELINE_VERSION=2026-08-21.1
SIMILAR_SKU_MAX_COSINE_DISTANCE=0.35
IMAGE_MAX_SIDE=1024
QUALITY_BLUR_LAPLACIAN_THRESHOLD=180
QUALITY_DENOISE_H=3
QUALITY_UNSHARP_AMOUNT=0.30
QUALITY_UNSHARP_SIGMA=1.0
LIGHTING_DARK_PIXEL_VALUE=32
LIGHTING_MODERATE_MEDIAN=60
LIGHTING_SEVERE_MEDIAN=30
LIGHTING_MODERATE_DARK_FRACTION=0.35
LIGHTING_SEVERE_DARK_FRACTION=0.60
LIGHTING_MODERATE_GAMMA=0.80
LIGHTING_SEVERE_GAMMA=0.60
LIGHTING_CLAHE_CLIP_LIMIT=1.8
LIGHTING_CLAHE_GRID_SIZE=8

IMAGE_STORAGE_ROOT=uploads
SKU_IMAGE_ROOT=data/images

# 데이터베이스 설정 / Database settings
# Docker 개발 환경을 구성할 때 사용합니다. / Used when the Docker development environment is added.
POSTGRES_DB=centagging
POSTGRES_USER=centagging
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
