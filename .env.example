# 로컬 실행에 필요한 환경 변수 예시 파일입니다. / Template for local environment variables.
# ─────────────────────────────────────────────────────────────
# centagging 환경 변수 템플릿
#
# 사용법:
#   cp .env.example .env
#   그 뒤 .env 파일에 실제 키 값을 채워 넣으세요.
#
#   .env 는 .gitignore 로 제외됩니다. 절대 커밋하지 마세요.
# ─────────────────────────────────────────────────────────────


# 애플리케이션 설정 / Application settings
APP_ENV=local
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501

# MVP fixed login account
# Set real values only in .env. Never commit the actual password.
MVP_LOGIN_ID=your-mvp-login-id
MVP_LOGIN_PASSWORD=your-mvp-login-password

# Gemini API 키
# AI 서비스 설정 / AI service settings
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_VLM_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# 데이터베이스 설정 / Database settings
# Docker 개발 환경을 구성할 때 사용합니다. / Used when the Docker development environment is added.
POSTGRES_DB=centagging
POSTGRES_USER=centagging
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
