# Copy this file to .env.prod on the deployment VM and replace non-secret placeholders.
# Keep runtime secret values empty and never commit .env.prod or real credentials.

# Public entry point
PUBLIC_HTTP_PORT=80

# Container images
# Keep these local defaults for manual VM builds. Replace them with Artifact
# Registry image URLs when the deployment workflow is enabled.
API_IMAGE=centagging-api:prod
FRONTEND_IMAGE=centagging-frontend:prod

# Google Cloud
GCP_PROJECT_ID=replace-with-gcp-project-id
GCP_REGION=asia-northeast3

# The bucket is mounted on the VM with Cloud Storage FUSE before Compose starts.
GCS_BUCKET_NAME=replace-with-production-bucket-name
GCS_MOUNT_ROOT=/mnt/centagging-gcs

# Secret Manager references
# Keep the runtime secret values below empty. The deployment process writes
# them to /run/centagging/secrets.env from these Secret Manager resources.
MVP_LOGIN_ID_SECRET_ID=centagging-prod-login-id
MVP_LOGIN_ID_SECRET_VERSION=1
MVP_LOGIN_PASSWORD_SECRET_ID=centagging-prod-login-password
MVP_LOGIN_PASSWORD_SECRET_VERSION=1
GEMINI_API_KEY_SECRET_ID=centagging-prod-gemini-api-key
GEMINI_API_KEY_SECRET_VERSION=1
POSTGRES_PASSWORD_SECRET_ID=centagging-prod-postgres-password
POSTGRES_PASSWORD_SECRET_VERSION=1

# Runtime secrets supplied by /run/centagging/secrets.env
MVP_LOGIN_ID=
MVP_LOGIN_PASSWORD=
GEMINI_API_KEY=
POSTGRES_PASSWORD=

# Application
GEMINI_VLM_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
IMAGE_STORAGE_ROOT=uploads
SKU_IMAGE_ROOT=data/images

# Cloud SQL for PostgreSQL
CLOUD_SQL_INSTANCE_CONNECTION_NAME=replace-with-project:region:instance
CLOUD_SQL_PROXY_IMAGE=gcr.io/cloud-sql-connectors/cloud-sql-proxy:2.23.0@sha256:54e23cad9aeeedbf88ab75f993146631b878035f702b31c51885a932e0c7286c
POSTGRES_DB=centagging
POSTGRES_USER=centagging
