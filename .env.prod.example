# Copy this file to .env.prod on the deployment VM and replace every placeholder.
# Never commit .env.prod or any real credentials.

# Public entry point
PUBLIC_HTTP_PORT=80

# Container images
# Keep these local defaults for manual VM builds. Replace them with Artifact
# Registry image URLs when the deployment workflow is enabled.
API_IMAGE=centagging-api:prod
FRONTEND_IMAGE=centagging-frontend:prod

# Application
MVP_LOGIN_ID=replace-with-production-login-id
MVP_LOGIN_PASSWORD=replace-with-a-strong-password
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_VLM_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
IMAGE_STORAGE_ROOT=uploads
SKU_IMAGE_ROOT=data/images

# PostgreSQL
POSTGRES_DB=centagging
POSTGRES_USER=centagging
POSTGRES_PASSWORD=replace-with-a-strong-database-password
