# ─────────────────────────────────────────────────────────────
# KOSA PoC 환경 변수 템플릿
#
# 사용법:
#   cp .env.example .env
#   그 뒤 .env 파일에 실제 키 값을 채워 넣으세요.
#
#   .env 는 .gitignore 로 제외됩니다. 절대 커밋하지 마세요.
# ─────────────────────────────────────────────────────────────

# Gemini API 키 (embedding / vlm-tagging / image-generation 공용)
# 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# 호스트에 노출할 포트 (기본값 그대로 두어도 무방)
EMBEDDING_PORT=8501
VLM_PORT=8502
IMAGE_GEN_PORT=8503