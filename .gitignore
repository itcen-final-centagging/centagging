# Git이 추적하지 않을 파일을 지정합니다. / Excludes files from Git tracking.
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Python 캐시와 테스트 산출물 / Python caches and test artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 가상환경 / Virtual environments
.venv/
venv/
env/
.conda/

# 로컬 실행 중 생성되는 파일 / Local runtime files
uploads/
outputs/
*.sqlite3

# 카탈로그 파이프라인 산출물 / Catalog pipeline artifacts
# 생성한 SKU 이미지는 용량이 커서 추적하지 않습니다.
# 메타데이터 JSON(data/catalog/)은 팀이 같은 카탈로그를 쓰도록 커밋합니다.
data/catalog/answer_sku
data/catalog/answer_sku.json

# IDE 및 운영체제 파일 / IDE and operating system files
.vscode/
.idea/
.DS_Store
Thumbs.db
