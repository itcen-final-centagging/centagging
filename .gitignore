# Git이 추적하지 않을 파일을 지정합니다. / Excludes files from Git tracking.
.env
.env.*
!.env.example
!.env.prod.example
.streamlit/secrets.toml

# Python 캐시와 테스트 산출물 / Python caches and test artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 가상환경 / Virtual environments
.venv/
venv/
env/
.conda/

# 로컬 실행 중 생성되는 파일 / Local runtime files
uploads/
outputs/
*.sqlite3

# React local dependencies and build artifacts
frontend/node_modules/
frontend/dist/
frontend/.eslintcache

data/images
resource
data/images

# IDE 및 운영체제 파일 / IDE and operating system files
.vscode/
.idea/
.DS_Store
Thumbs.db
